{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    ".ai/AGENT_HANDOFF.md",
    ".ai/PROJECT_CONTEXT.md",
    ".ai/RETRIEVAL_INDEX.md"
  ],
  "permission": {
    "edit": {
      "*": "ask",
      ".github/**": "ask",
      "**/.github/**": "ask",
      "package-lock.json": "ask",
      "yarn.lock": "ask",
      "pnpm-lock.yaml": "ask",
      "**/auth/**": "ask",
      "**/authentication/**": "ask",
      "**/authorization/**": "ask",
      "**/cors*": "ask",
      "**/csp*": "ask",
      "**/payment/**": "ask",
      "**/billing/**": "ask",
      "**/analytics/**": "ask",
      "**/consent/**": "ask",
      "**/deploy/**": "ask",
      "**/deployment/**": "ask",
      "**/upload-dist*": "ask",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "id_rsa": "deny",
      "id_ed25519": "deny",
      "**/id_rsa": "deny",
      "**/id_ed25519": "deny",
      ".aws/**": "deny",
      ".gcp/**": "deny",
      ".azure/**": "deny",
      "**/.aws/**": "deny",
      "**/.gcp/**": "deny",
      "**/.azure/**": "deny",
      ".npmrc": "deny",
      ".yarnrc": "deny",
      ".pnpmrc": "deny",
      "**/.npmrc": "deny",
      "**/.yarnrc": "deny",
      "**/.pnpmrc": "deny",
      "secrets/**": "deny",
      "credentials/**": "deny",
      "**/secrets/**": "deny",
      "**/credentials/**": "deny",
      "**/*token*": "deny",
      "**/*secret*": "deny",
      "**/*credential*": "deny",
      ".git/**": "deny",
      "**/.git/**": "deny"
    },
    "webfetch": "ask",
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "id_rsa": "deny",
      "id_ed25519": "deny",
      "**/id_rsa": "deny",
      "**/id_ed25519": "deny",
      ".aws/**": "deny",
      ".gcp/**": "deny",
      ".azure/**": "deny",
      "**/.aws/**": "deny",
      "**/.gcp/**": "deny",
      "**/.azure/**": "deny",
      ".npmrc": "deny",
      ".yarnrc": "deny",
      ".pnpmrc": "deny",
      "**/.npmrc": "deny",
      "**/.yarnrc": "deny",
      "**/.pnpmrc": "deny",
      "secrets/**": "deny",
      "credentials/**": "deny",
      "**/secrets/**": "deny",
      "**/credentials/**": "deny",
      "**/*token*": "deny",
      "**/*secret*": "deny",
      "**/*credential*": "deny"
    },
    "bash": {
      "*": "ask",
      "npm run build*": "allow",
      "npm run lint*": "allow",
      "npm run test*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git show*": "allow",
      "node .ai/scripts/rotate-handoff.mjs*": "allow",
      "node .ai/scripts/archive-plan.mjs*": "allow",
      "codegraph index*": "allow",
      "codegraph sync*": "allow",
      "codegraph query*": "allow",
      "codegraph context*": "allow",
      "codegraph affected*": "allow",
      "codegraph files*": "allow",
      "codegraph status*": "allow",
      "codegraph serve*": "allow",
      "git push*": "ask",
      "npm install*": "deny",
      "npm ci*": "deny",
      "npm i": "deny",
      "npm i *": "deny",
      "npm uninstall*": "deny",
      "npm update*": "deny",
      "npm publish*": "deny",
      "npm audit fix*": "deny",
      "npx": "deny",
      "npx *": "deny",
      "yarn add*": "deny",
      "yarn install*": "deny",
      "yarn dlx*": "deny",
      "pnpm add*": "deny",
      "pnpm install*": "deny",
      "pnpm dlx*": "deny",
      "bun install*": "deny",
      "bun add*": "deny",
      "curl": "deny",
      "curl *": "deny",
      "wget": "deny",
      "wget *": "deny",
      "Invoke-WebRequest*": "deny",
      "Invoke-RestMethod*": "deny",
      "iwr": "deny",
      "iwr *": "deny",
      "irm": "deny",
      "irm *": "deny",
      "Start-BitsTransfer*": "deny",
      "git commit*": "deny",
      "git push --mirror*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push --force-with-lease*": "deny",
      "git reset --hard*": "deny",
      "git clean -fdx*": "deny",
      "git clean -fd*": "deny",
      "rm -rf*": "deny",
      "Remove-Item -Recurse -Force*": "deny",
      "Remove-Item -Force -Recurse*": "deny",
      "docker system prune*": "deny"
    }
  },
  "agent": {
    "plan": {
      "mode": "primary",
      "prompt": "Plan only. Read the repository context, identify risks, and propose steps. Do not edit files or run commands.",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "webfetch": "ask"
      }
    },
    "fix": {
      "mode": "primary",
      "prompt": "Implementation agent. Follow AGENTS.md and the canonical .ai workspace. Keep changes minimal and use the global permissions in this config. After code edits, before the final response, follow .ai/HARNESS.md \"Post-Edit Review Gate\" — single source of truth for the trigger taxonomy, the skip allowlist, the subagents to invoke, and the per-tool persona paths. Report blockers or unresolved findings clearly."
    },
    "code-reviewer": {
      "description": "Reviews changes for bugs, security risks, regressions, and missing verification.",
      "mode": "subagent",
      "prompt": "Review code with findings first. Focus on correctness, security, TV/runtime constraints, and test coverage. Do not edit files.",
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "webfetch": "ask"
      }
    },
    "test-runner": {
      "description": "Runs available project verification commands, diagnoses failures, and iterates on minimal approved fixes until checks are green.",
      "mode": "subagent",
      "prompt": "You are an automated CI pipeline execution agent. Read .ai/PROJECT_CONTEXT.md to identify available test, lint, typecheck, and build commands. If no test command exists, say so and run the closest approved verification only when appropriate. Capture output, diagnose failures from stack traces, apply minimal fixes when allowed, and rerun until green or blocked. Report command, final status, attempts, and concise output summary.",
      "permission": {
        "edit": "ask",
        "bash": "ask",
        "webfetch": "ask"
      }
    }
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  }
}
